---
import Basis from "../layouts/Basis.astro";
import Produktfoto from "../components/Produktfoto.astro";
import Preisblock from "../components/Preisblock.astro";
import Kaufbutton from "../components/Kaufbutton.astro";
import Kaufleiste from "../components/Kaufleiste.astro";
import Wert from "../components/Wert.astro";
import {
  produkt,
  voll,
  preisFormatiert,
  technischeDaten,
  zahlenLink,
} from "../lib/produkt";

const beschreibung =
  `${voll}: Mini-Beamer mit ${produkt.aufloesung}er Auflösung, ${produkt.betriebssystem} ` +
  `und ${produkt.lumen} Lumen. ${preisFormatiert} inkl. MwSt.`;

/** Was 200 Lumen im Alltag heißen. Keine Marketingkurve, eine Ansage. */
const lichtlagen = [
  {
    lage: "Abgedunkelter Raum",
    urteil: "Dafür gebaut",
    ton: "gut" as const,
    text: "Rollladen unten oder Nacht. Hier zeigt der One, was er kann: sattes Schwarz, klare Kanten, ruhige Flächen.",
  },
  {
    lage: "Abends mit Vorhang",
    urteil: "Geht gut",
    ton: "okay" as const,
    text: "Restlicht von der Straßenlaterne stört kaum. Das Bild wird etwas flacher, bleibt aber gut anzusehen.",
  },
  {
    lage: "Tageslicht",
    urteil: "Nicht sinnvoll",
    ton: "schlecht" as const,
    text: "200 Lumen kommen gegen ein helles Zimmer nicht an. Wer mittags projizieren will, braucht ein anderes Gerät — und soll es nicht hier kaufen.",
  },
];

const staerken = [
  {
    titel: produkt.aufloesung,
    text: "Das Panel stellt 1920 × 1080 Bildpunkte dar — nativ, nicht hochgerechnet. Schrift bleibt lesbar, Untertitel sauber.",
    icon: "raster",
  },
  {
    titel: produkt.betriebssystem,
    text: "Apps laufen direkt auf dem Gerät. Kein Stick, kein zweites Netzteil, kein zusätzliches HDMI-Kabel im Weg.",
    icon: "android",
  },
  {
    titel: produkt.funk,
    text: "Ins WLAN, fertig. Ton geht per Bluetooth 5.0 an Box oder Kopfhörer, wenn der eingebaute Lautsprecher nicht reicht.",
    icon: "funk",
  },
  {
    titel: produkt.technik,
    text: "LCD-Panel mit LED-Lichtquelle. Keine Lampe, die nach ein paar hundert Stunden getauscht werden will.",
    icon: "lampe",
  },
];

const fragen = [
  {
    frage: "Brauche ich zusätzlich einen Streaming-Stick?",
    antwort:
      `Nein. ${produkt.betriebssystem} läuft auf dem Gerät selbst, der One geht direkt ins WLAN. ` +
      "Ob eine bestimmte App dort verfügbar ist und in welcher Qualität sie ausgibt, entscheidet der jeweilige Anbieter — das können wir nicht pauschal zusagen.",
  },
  {
    frage: "Ist das ein 4K-Beamer?",
    antwort:
      "Nein, und wir nennen ihn auch nicht so. Die native Auflösung ist 1080p. " +
      "Er nimmt Signale bis 4K entgegen und gibt sie in 1080p aus — das Bild bleibt also nutzbar, wenn die Quelle höher aufgelöst sendet.",
  },
  {
    frage: "Reicht die Helligkeit für mein Wohnzimmer?",
    antwort:
      "Abends und mit zugezogenem Vorhang: ja. Bei Tageslicht: nein. " +
      "200 Lumen sind für dunkle Räume ausgelegt. Wenn das nicht zu Ihrer Situation passt, sparen Sie sich den Kauf lieber — deshalb steht es hier so deutlich.",
  },
  {
    frage: "Was, wenn er mir nicht gefällt?",
    antwort:
      "Sie haben 14 Tage Widerrufsrecht ab Erhalt der Ware, ohne Angabe von Gründen. " +
      "Die Einzelheiten und das Musterformular stehen auf der Seite Widerrufsrecht.",
  },
];

const ldJson = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: voll,
  brand: { "@type": "Brand", name: produkt.marke },
  description: beschreibung,
  image: new URL("/bilder/lumora-one-og.jpg", Astro.site).href,
  offers: {
    "@type": "Offer",
    price: produkt.preis,
    priceCurrency: produkt.waehrung,
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
    url: Astro.site!.href,
  },
};
---

<Basis
  titel={`${voll} — Mini-Beamer mit ${produkt.aufloesung} für ${preisFormatiert}`}
  beschreibung={beschreibung}
  ogTyp="product"
>
  <script type="application/ld+json" set:html={JSON.stringify(ldJson)} is:inline />

  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-[38rem] bg-[radial-gradient(60%_60%_at_70%_10%,rgba(59,108,255,.14),transparent_70%)]"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative mx-auto grid max-w-6xl items-center gap-10 px-5 pb-16 pt-12 sm:px-8 sm:pb-20 sm:pt-16 lg:grid-cols-[1.15fr_1fr] lg:gap-14 lg:pt-24"
    >
      <div>
        <p
          class="mb-5 inline-flex items-center gap-2 rounded-full border border-kante bg-papier px-3.5 py-1.5 text-xs font-semibold tracking-[0.16em] text-tinte-leise uppercase"
        >
          <span class="h-1.5 w-1.5 rounded-full u-beam" aria-hidden="true"></span>
          Mini-Beamer
        </p>

        <h1
          class="text-[2.6rem] leading-[1.05] font-semibold text-balance sm:text-[3.4rem] lg:text-[3.9rem]"
        >
          Echtes 1080p.<br />
          <span class="u-beam-text">Für den dunklen Raum.</span>
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-tinte-weich">
          Der {voll} projiziert {produkt.aufloesung} — nicht hochgerechnet, sondern
          Punkt für Punkt. {produkt.betriebssystem} ist eingebaut, Streaming läuft
          also ohne zusätzliche Box. Mit {produkt.lumen} Lumen ist er ein
          Abendgerät, kein Tageslichtbeamer. Das sagen wir lieber vorher.
        </p>

        <div class="mt-9 rounded-blende border border-kante bg-papier p-6 shadow-sm">
          <Preisblock />
          <div class="mt-6" id="kaufen">
            <Kaufbutton gross={true} />
          </div>
          <ul
            class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-tinte-leise"
          >
            <li class="flex items-center gap-1.5">
              <span class="text-strahl" aria-hidden="true">✓</span>
              14 Tage Widerrufsrecht
            </li>
            <li class="flex items-center gap-1.5">
              <span class="text-strahl" aria-hidden="true">✓</span>
              Versand aus Deutschland
            </li>
            <li class="flex items-center gap-1.5">
              <span class="text-strahl" aria-hidden="true">✓</span>
              Zahlung über Stripe
            </li>
          </ul>
        </div>
      </div>

      <div class="relative u-kegel">
        <div class="relative z-10 mx-auto max-w-md lg:max-w-none">
          <Produktfoto
            alt={`${voll} — weißer Mini-Beamer auf Standbügel, schräg von vorn, mit beleuchtetem Objektiv`}
            sizes="(min-width: 1024px) 44vw, (min-width: 640px) 60vw, 88vw"
            prioritaet={true}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ── 200 Lumen, ehrlich ────────────────────────────────────────────── -->
  <section id="licht" class="border-y border-kante bg-tinte text-papier">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <div class="max-w-2xl">
        <p
          class="mb-4 text-xs font-semibold tracking-[0.16em] text-linse uppercase"
        >
          Der wichtigste Absatz auf dieser Seite
        </p>
        <h2 class="text-3xl font-semibold sm:text-4xl">
          {produkt.lumen} Lumen — was das heißt
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-papier/70">
          Helligkeit ist bei Beamern die Angabe, an der die meisten Enttäuschungen
          hängen. Deshalb hier ohne Umweg: Der {produkt.modell} ist für dunkle
          Räume gebaut. Je mehr Fremdlicht im Zimmer ist, desto blasser wird das
          Bild. Das ist keine Schwäche des einzelnen Geräts, sondern Physik bei
          dieser Klasse.
        </p>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-3">
        {
          lichtlagen.map((l) => (
            <div class="rounded-blende border border-papier/12 bg-papier/[0.045] p-6">
              <div class="mb-4 flex items-center justify-between gap-3">
                <h3 class="text-lg font-semibold">{l.lage}</h3>
                <span
                  class:list={[
                    "shrink-0 rounded-full px-2.5 py-1 text-[0.7rem] font-semibold whitespace-nowrap",
                    l.ton === "gut" && "bg-linse/20 text-linse",
                    l.ton === "okay" && "bg-strahl/25 text-[#9db7ff]",
                    l.ton === "schlecht" && "bg-papier/10 text-papier/55",
                  ]}
                >
                  {l.urteil}
                </span>
              </div>
              <div
                class:list={[
                  "mb-4 h-1.5 rounded-full",
                  l.ton === "gut" && "u-beam",
                  l.ton === "okay" && "bg-strahl/55",
                  l.ton === "schlecht" && "bg-papier/12",
                ]}
                aria-hidden="true"
              />
              <p class="text-sm leading-relaxed text-papier/65">{l.text}</p>
            </div>
          ))
        }
      </div>

      <p class="mt-10 max-w-2xl text-sm text-papier/45">
        Wir lassen diesen Abschnitt bewusst stehen, auch wenn er Bestellungen
        kostet. Ein Gerät, das im falschen Raum landet, geht zurück — davon hat
        niemand etwas.
      </p>
    </div>
  </section>

  <!-- ── Technik ───────────────────────────────────────────────────────── -->
  <section id="technik" class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <h2 class="max-w-2xl text-3xl font-semibold sm:text-4xl">
      Was drinsteckt, ohne Sternchen
    </h2>

    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {
        staerken.map((s) => (
          <div class="u-karte p-7">
            <div
              class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl u-beam text-papier"
              aria-hidden="true"
            >
              {s.icon === "raster" && (
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="16" rx="2" />
                  <path d="M3 10h18M9 4v16" />
                </svg>
              )}
              {s.icon === "android" && (
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 11h14v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7Z" />
                  <path d="M7.5 11a4.5 4.5 0 0 1 9 0M8.5 5.5 7 3.5M15.5 5.5 17 3.5" stroke-linecap="round" />
                </svg>
              )}
              {s.icon === "funk" && (
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M4.5 9.5a10.5 10.5 0 0 1 15 0M7.5 13a6.2 6.2 0 0 1 9 0" />
                  <circle cx="12" cy="17.5" r="1.4" fill="currentColor" stroke="none" />
                </svg>
              )}
              {s.icon === "lampe" && (
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <circle cx="12" cy="10" r="4.5" />
                  <path d="M12 2.5v1.5M12 16v1.5M3.6 10h1.5M18.9 10h1.5M6.1 4.1l1.1 1.1M16.8 14.8l1.1 1.1M17.9 4.1l-1.1 1.1M7.2 14.8l-1.1 1.1" />
                </svg>
              )}
            </div>
            <h3 class="text-lg font-semibold text-tinte">{s.titel}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-tinte-weich">{s.text}</p>
          </div>
        ))
      }
    </div>

    <!-- 1080p vs. 4K, weil die Angabe sonst missverstanden wird -->
    <div class="mt-5 u-karte bg-dunst p-7 sm:p-9">
      <h3 class="text-xl font-semibold text-tinte">
        „Bis 4K" heißt hier: das Signal, nicht das Bild
      </h3>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-tinte-weich">
        Der {produkt.modell} akzeptiert Zuspieler, die bis 4K senden, und rechnet
        sie auf seine native Auflösung herunter. An der Wand landen {produkt.aufloesung}.
        Ein 4K-Beamer ist er damit nicht, und als solcher wird er hier auch
        nirgends beworben — auch nicht im Kleingedruckten.
      </p>
    </div>
  </section>

  <!-- ── Datenblatt ────────────────────────────────────────────────────── -->
  <section id="daten" class="border-t border-kante bg-dunst">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
      <div class="max-w-3xl">
      <h2 class="text-3xl font-semibold sm:text-4xl">Technische Daten</h2>
      <p class="mt-3 text-sm text-tinte-leise">
        Nur Werte, die wir belegen können. Was noch offen ist, steht offen da.
      </p>

      <dl class="mt-10 divide-y divide-kante border-y border-kante">
        {
          technischeDaten.map((z) => (
            <div class="grid gap-1 py-4 sm:grid-cols-[15rem_1fr] sm:gap-6">
              <dt class="text-sm font-medium text-tinte-leise">{z.feld}</dt>
              <dd class="text-sm font-medium text-tinte">
                <Wert wert={z.wert} name={z.feld.toUpperCase()} />
              </dd>
            </div>
          ))
        }
        </dl>
      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────────────────── -->
  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-semibold sm:text-4xl">Häufige Fragen</h2>
      <div class="mt-10 space-y-3">
      {
        fragen.map((f) => (
          <details class="group u-karte px-6 py-5 open:bg-dunst">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-base font-semibold text-tinte marker:content-['']">
              {f.frage}
              <svg
                viewBox="0 0 20 20"
                class="h-5 w-5 shrink-0 text-tinte-leise transition-transform duration-200 group-open:rotate-45"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M9 4h2v12H9z" />
                <path d="M4 9h12v2H4z" />
              </svg>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-tinte-weich">{f.antwort}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- ── Abschluss ─────────────────────────────────────────────────────── -->
  <section class="border-t border-kante bg-tinte text-papier">
    <div class="mx-auto max-w-3xl px-5 py-16 text-center sm:px-8 sm:py-24">
      <h2 class="text-3xl font-semibold sm:text-4xl">
        Ein Produkt. Ein Preis. Keine Varianten.
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-papier/65">
        {voll} für {preisFormatiert} inkl. MwSt. Lieferzeit {produkt.lieferzeit}.
        Die Zahlung läuft über Stripe, wir sehen Ihre Kartendaten nicht.
      </p>

      <div class="mt-9 flex flex-col items-center gap-4">
        <Kaufbutton gross={true} />
        {
          zahlenLink && (
            <p class="text-xs text-papier/45">
              Mit dem Klick werden Sie zu Stripe weitergeleitet und schließen den
              Kauf dort ab.
            </p>
          )
        }
      </div>

      <p class="mx-auto mt-10 max-w-xl text-xs leading-relaxed text-papier/40">
        Es gelten unsere{" "}
        <a href="/agb" class="underline underline-offset-2 hover:text-papier/70">AGB</a>.
        Informationen zu Versand und Zahlung finden Sie unter{" "}
        <a href="/versand" class="underline underline-offset-2 hover:text-papier/70">Versand &amp; Zahlung</a>,
        zum Widerrufsrecht unter{" "}
        <a href="/widerruf" class="underline underline-offset-2 hover:text-papier/70">Widerrufsrecht</a>.
      </p>
    </div>
  </section>

  <Kaufleiste slot="nach-fuss" />
</Basis>
