---
import Basis from "../layouts/Basis.astro";
---

<Basis
  titel="Seite nicht gefunden — Lumora"
  beschreibung="Diese Adresse gibt es auf lumora nicht."
>
  <section class="mx-auto max-w-xl px-5 py-24 text-center sm:px-8 sm:py-32">
    <p class="text-sm font-semibold tracking-[0.16em] text-tinte-leise uppercase">
      Fehler 404
    </p>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">
      Hier ist nichts zu sehen.
    </h1>
    <p class="mt-4 text-tinte-weich">
      Die Seite gibt es nicht — oder nicht mehr. Auf der Startseite steht alles
      Wesentliche.
    </p>
    <a
      href="/"
      class="mt-9 inline-flex items-center justify-center rounded-full u-beam px-6 py-3 font-semibold text-papier"
      >Zur Startseite</a
    >
  </section>
</Basis>
