---
import "@fontsource-variable/inter";
import "../styles/global.css";
import Kopf from "../components/Kopf.astro";
import Fuss from "../components/Fuss.astro";
import { voll, preisFormatiert } from "../lib/produkt";

interface Props {
  titel: string;
  beschreibung: string;
  /** Nur die Startseite soll als Produkt indexiert werden. */
  ogTyp?: "website" | "product";
}

const { titel, beschreibung, ogTyp = "website" } = Astro.props;
const kanonisch = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, "") || Astro.site!.href;
const ogBild = new URL("/bilder/lumora-one-og.jpg", Astro.site).href;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={kanonisch} />

    <link rel="icon" href="/bilder/lumora-mark.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b1020" />

    <meta property="og:type" content={ogTyp} />
    <meta property="og:site_name" content="Lumora" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={kanonisch} />
    <meta property="og:image" content={ogBild} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${voll} — Mini-Beamer`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titel} />
    <meta name="twitter:description" content={beschreibung} />
    <meta name="twitter:image" content={ogBild} />

    {
      ogTyp === "product" && (
        <meta name="product:price:amount" content={String(preisFormatiert)} />
      )
    }
  </head>

  <body class="min-h-dvh">
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-tinte focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-papier"
      >Zum Inhalt springen</a
    >
    <Kopf />
    <main id="inhalt">
      <slot />
    </main>
    <Fuss />
    <slot name="nach-fuss" />
  </body>
</html>
