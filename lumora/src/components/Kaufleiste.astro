---
import Kaufbutton from "./Kaufbutton.astro";
import { preisFormatiert, versandSatz, produkt, zahlenLink } from "../lib/produkt";
---

{/* Feste Kaufleiste auf Mobil. Ab sm uebernimmt der Block im Hero. */}
<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-kante bg-papier/95 px-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 backdrop-blur-md sm:hidden"
>
  <div class="flex items-center gap-3">
    <div class="min-w-0 flex-1">
      <div class="flex items-baseline gap-1.5">
        <span class="text-lg font-semibold text-tinte">{preisFormatiert}</span>
        <span class="text-[0.7rem] text-tinte-leise">inkl. MwSt.</span>
      </div>
      <p class="truncate text-[0.7rem] text-tinte-leise">
        {versandSatz.offen ? <span class="u-offen">Versand offen</span> : versandSatz.text}
        <span aria-hidden="true"> · </span>{produkt.lieferzeit}
      </p>
    </div>
    {
      zahlenLink ? (
        <Kaufbutton klasse="shrink-0 px-5 py-3 text-sm" />
      ) : (
        <a
          href="#kaufen"
          class="shrink-0 rounded-full u-beam px-5 py-3 text-sm font-semibold text-papier"
        >
          Zum Bestellen
        </a>
      )
    }
  </div>
</div>

{/* Platz, damit die Leiste nichts verdeckt. */}
<div class="h-24 sm:hidden" aria-hidden="true"></div>
